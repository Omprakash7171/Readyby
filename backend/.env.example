# Copy to backend/.env for local development. Never commit the real file.
# These names are the ones backend/readyby_api/settings.py actually reads.

# --- Core -------------------------------------------------------------------
# Leave empty while DEBUG is true; a development-only key is used instead.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use local SQLite (backend/db.sqlite3).
# PostgreSQL example:
# DATABASE_URL=postgres://readyby:password@localhost:5432/readyby

# --- Frontend origins --------------------------------------------------------
# Comma-separated list of Next.js origins allowed to call the API.
# Include BOTH spellings of the local address: the browser sends whichever one
# was typed, and a missing one shows up as a CORS failure that looks like the
# API is down. In production set this to your deployed frontend origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Pilot behaviour ---------------------------------------------------------
# Fictional sample cafés are hidden unless this is true.
SHOW_DEMO_CAFES=true
# Optional. The seed command falls back to readyby-demo-2026 for local use.
# DEMO_SEED_PASSWORD=readyby-demo-2026

# --- Site --------------------------------------------------------------------
TIME_ZONE=Europe/London

# --- Throttles (per minute) --------------------------------------------------
# THROTTLE_ANON_PER_MIN=120/min
# THROTTLE_USER_PER_MIN=300/min
# THROTTLE_LOGIN_PER_MIN=10/min
# THROTTLE_ORDER_CREATE_PER_MIN=20/min
# THROTTLE_ORDER_STATUS_PER_MIN=120/min

# --- Operational overrides ---------------------------------------------------
# LOG_LEVEL=INFO
# SENTRY_DSN=